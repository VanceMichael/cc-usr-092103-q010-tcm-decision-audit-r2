{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "方证术语",
  "type": "object",
  "required": ["domain", "version", "patterns", "formulas", "diseases", "experiences"],
  "properties": {
    "domain": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named"}},
    "formulas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named"}},
    "diseases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/named"}},
    "experiences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "name", "version", "effective_from", "summary"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "integer", "minimum": 1},
          "effective_from": {"type": "string", "format": "date-time"},
          "summary": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "named": {
      "type": "object",
      "required": ["code", "name"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
