{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "机构层级与模型版本登记",
  "type": "object",
  "required": ["domain", "version", "institutions"],
  "properties": {
    "domain": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "institutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "tier"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "tier": {"enum": ["总院", "院区", "区域医疗中心", "医联体"]},
          "parent": {"type": ["string", "null"]},
          "registrations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["model_version", "diseases", "effective_from"],
              "properties": {
                "model_version": {"type": "string", "minLength": 1},
                "diseases": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "effective_from": {"type": "string", "format": "date-time"},
                "deactivate_if": {
                  "type": "object",
                  "properties": {
                    "after": {"type": ["string", "null"], "format": "date-time"},
                    "adverse_events_at_least": {"type": ["integer", "null"], "minimum": 1}
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
