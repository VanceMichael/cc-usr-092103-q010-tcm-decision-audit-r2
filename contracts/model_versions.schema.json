{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "模型版本规则表",
  "type": "object",
  "required": ["domain", "version", "models"],
  "properties": {
    "domain": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "released_at", "rules"],
        "properties": {
          "version": {"type": "string", "minLength": 1},
          "released_at": {"type": "string", "format": "date-time"},
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["disease_code", "pattern_code", "formula_code", "experience_code", "experience_version"],
              "properties": {
                "disease_code": {"type": "string", "minLength": 1},
                "pattern_code": {"type": "string", "minLength": 1},
                "formula_code": {"type": "string", "minLength": 1},
                "experience_code": {"type": "string", "minLength": 1},
                "experience_version": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
